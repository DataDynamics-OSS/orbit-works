[
  {
    "kind": "EXPENSE",
    "name": "지출결의서",
    "icon": "Receipt",
    "description": "일반 지출의 사전 결재. 카테고리·금액·증빙 첨부.",
    "form_schema": {
      "type": "object",
      "required": ["amount", "category", "purpose", "spent_at"],
      "properties": {
        "amount": {
          "type": "integer",
          "title": "금액 (원)",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "title": "분류",
          "enum": ["식대", "교통", "사무용품", "통신", "회식", "기타"]
        },
        "vendor": { "type": "string", "title": "거래처" },
        "spent_at": {
          "type": "string",
          "format": "date",
          "title": "사용일"
        },
        "purpose": {
          "type": "string",
          "title": "사용 목적",
          "minLength": 5
        }
      }
    },
    "ui_schema": {
      "amount": { "ui:widget": "money" },
      "purpose": { "ui:widget": "richText" }
    },
    "approval_rules": {
      "rules": [
        {
          "name": "100만 이하 — 매니저 결재",
          "when": { "form_data.amount": { "lte": 1000000 } },
          "approvers": [{ "type": "manager", "step_name": "1차 결재" }]
        },
        {
          "name": "100~500만 — 본부장급",
          "when": { "form_data.amount": { "gt": 1000000, "lte": 5000000 } },
          "approvers": [
            { "type": "manager", "step_name": "1차 결재" },
            { "type": "rank_min_level", "level": 600, "step_name": "본부장급 결재" }
          ]
        },
        {
          "name": "500만 초과 — 대표 결재",
          "when": { "form_data.amount": { "gt": 5000000 } },
          "approvers": [
            { "type": "manager", "step_name": "1차 결재" },
            { "type": "rank_min_level", "level": 600, "step_name": "본부장급 결재" },
            { "type": "rank_min_level", "level": 1000, "step_name": "대표 결재" }
          ]
        }
      ]
    },
    "attachment_slots": {
      "slots": [
        {
          "slug": "receipt",
          "label": "영수증",
          "required": false,
          "description": "법인카드/세금계산서/현금영수증 등 적격증빙."
        }
      ]
    }
  },

  {
    "kind": "LEAVE",
    "name": "휴가 신청서",
    "icon": "Plane",
    "description": "연차·반차 등 휴가 사용 신청.",
    "form_schema": {
      "type": "object",
      "required": ["leave_kind", "start_date", "end_date", "days", "reason"],
      "properties": {
        "leave_kind": {
          "type": "string",
          "title": "휴가 종류",
          "enum": ["연차", "반차(오전)", "반차(오후)", "병가", "경조", "기타"]
        },
        "start_date": { "type": "string", "format": "date", "title": "시작일" },
        "end_date": { "type": "string", "format": "date", "title": "종료일" },
        "days": { "type": "number", "title": "사용 일수", "minimum": 0 },
        "reason": { "type": "string", "title": "사유", "minLength": 2 }
      }
    },
    "ui_schema": {
      "reason": { "ui:widget": "textarea", "ui:options": { "rows": 3 } }
    },
    "approval_rules": {
      "rules": [
        {
          "name": "휴가 — 5일 이하",
          "when": { "form_data.days": { "lte": 5 } },
          "approvers": [{ "type": "manager", "step_name": "1차 결재" }]
        },
        {
          "name": "휴가 — 5일 초과 (HR 추가)",
          "when": { "form_data.days": { "gt": 5 } },
          "approvers": [
            { "type": "manager", "step_name": "1차 결재" },
            { "type": "rank_min_level", "level": 700, "step_name": "임원 결재" }
          ]
        }
      ]
    }
  },

  {
    "kind": "BUSINESS_TRIP",
    "name": "출장 신청서",
    "icon": "PlaneTakeoff",
    "description": "국내·해외 출장 사전 신청. 사후 정산은 별도 결재.",
    "form_schema": {
      "type": "object",
      "required": ["destination", "start_date", "end_date", "purpose"],
      "properties": {
        "destination": { "type": "string", "title": "행선지" },
        "is_overseas": { "type": "boolean", "title": "해외 출장" },
        "start_date": { "type": "string", "format": "date", "title": "시작일" },
        "end_date": { "type": "string", "format": "date", "title": "종료일" },
        "estimated_amount": {
          "type": "integer",
          "title": "예상 비용 (원)",
          "minimum": 0
        },
        "advance_payment": {
          "type": "integer",
          "title": "가지급 신청액 (원)",
          "minimum": 0
        },
        "purpose": { "type": "string", "title": "출장 목적", "minLength": 5 }
      }
    },
    "ui_schema": {
      "estimated_amount": { "ui:widget": "money" },
      "purpose": { "ui:widget": "richText" }
    },
    "approval_rules": {
      "rules": [
        {
          "name": "국내 출장 (100만 이하)",
          "when": {
            "form_data.is_overseas": { "eq": false },
            "form_data.estimated_amount": { "lte": 1000000 }
          },
          "approvers": [{ "type": "manager", "step_name": "1차 결재" }]
        },
        {
          "name": "국내 출장 (100만 초과)",
          "when": {
            "form_data.is_overseas": { "eq": false },
            "form_data.estimated_amount": { "gt": 1000000 }
          },
          "approvers": [
            { "type": "manager", "step_name": "1차 결재" },
            { "type": "rank_min_level", "level": 600, "step_name": "본부장급 결재" }
          ]
        },
        {
          "name": "해외 출장",
          "when": { "form_data.is_overseas": { "eq": true } },
          "approvers": [
            { "type": "manager", "step_name": "1차 결재" },
            { "type": "rank_min_level", "level": 600, "step_name": "본부장급 결재" },
            { "type": "rank_min_level", "level": 1000, "step_name": "대표 결재" }
          ]
        }
      ]
    },
    "attachment_slots": {
      "slots": [
        {
          "slug": "itinerary",
          "label": "일정·예산표",
          "required": false,
          "description": "출장 일정과 예상 비용 내역."
        },
        {
          "slug": "ticket",
          "label": "항공·교통권",
          "required": false,
          "description": "예약 확인서 또는 e-티켓."
        }
      ]
    }
  },

